{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ControllerControlOwnershipChangedReason": {
      "enum": [
        "initialLeaseGranted",
        "acquired",
        "released",
        "reclaimedByTui",
        "leaseExpired",
        "authorizationRevoked",
        "controllerDisconnected",
        "signOff",
        "mainThreadClosed",
        "tuiUnavailable"
      ],
      "type": "string"
    },
    "ControllerLease": {
      "properties": {
        "expiresInMs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "leaseId": {
          "type": "string"
        },
        "ownerEpoch": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "leaseId",
        "ownerEpoch"
      ],
      "type": "object"
    }
  },
  "properties": {
    "activeLease": {
      "anyOf": [
        {
          "$ref": "#/definitions/ControllerLease"
        },
        {
          "type": "null"
        }
      ]
    },
    "authorizationEpoch": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "mainThreadId": {
      "type": "string"
    },
    "ownerEpoch": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "reason": {
      "$ref": "#/definitions/ControllerControlOwnershipChangedReason"
    },
    "sessionId": {
      "type": "string"
    },
    "sessionSequence": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "authorizationEpoch",
    "mainThreadId",
    "ownerEpoch",
    "reason",
    "sessionId",
    "sessionSequence"
  ],
  "title": "ControllerControlOwnershipChangedNotification",
  "type": "object"
}