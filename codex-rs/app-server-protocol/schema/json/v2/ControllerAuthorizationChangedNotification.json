{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ControllerAuthorizationChangedReason": {
      "enum": [
        "approved",
        "rejected",
        "revoked",
        "expired",
        "credentialRotated",
        "policyChanged",
        "signOff",
        "disconnected",
        "mainThreadClosed",
        "tuiUnavailable"
      ],
      "type": "string"
    },
    "ControllerEffectiveCapabilities": {
      "properties": {
        "acquireControl": {
          "type": "boolean"
        },
        "answerPrompts": {
          "type": "boolean"
        },
        "mutateMainThread": {
          "type": "boolean"
        },
        "readMainThread": {
          "type": "boolean"
        },
        "releaseControl": {
          "type": "boolean"
        },
        "subscribeMainThread": {
          "type": "boolean"
        }
      },
      "required": [
        "acquireControl",
        "answerPrompts",
        "mutateMainThread",
        "readMainThread",
        "releaseControl",
        "subscribeMainThread"
      ],
      "type": "object"
    },
    "ControllerLease": {
      "properties": {
        "expiresInMs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "leaseId": {
          "type": "string"
        },
        "ownerEpoch": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "leaseId",
        "ownerEpoch"
      ],
      "type": "object"
    },
    "ControllerSession": {
      "properties": {
        "activeLease": {
          "anyOf": [
            {
              "$ref": "#/definitions/ControllerLease"
            },
            {
              "type": "null"
            }
          ]
        },
        "authorizationEpoch": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "authorizationExpiresInMs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "effectiveCapabilities": {
          "$ref": "#/definitions/ControllerEffectiveCapabilities"
        },
        "leaseExpiresInMs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "mainThreadId": {
          "type": "string"
        },
        "sessionId": {
          "type": "string"
        },
        "sessionSequence": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "authorizationEpoch",
        "effectiveCapabilities",
        "mainThreadId",
        "sessionId",
        "sessionSequence"
      ],
      "type": "object"
    }
  },
  "properties": {
    "authorizationEpoch": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "mainThreadId": {
      "type": "string"
    },
    "ownerEpoch": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "reason": {
      "$ref": "#/definitions/ControllerAuthorizationChangedReason"
    },
    "session": {
      "anyOf": [
        {
          "$ref": "#/definitions/ControllerSession"
        },
        {
          "type": "null"
        }
      ]
    },
    "sessionId": {
      "type": "string"
    },
    "sessionSequence": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "authorizationEpoch",
    "mainThreadId",
    "ownerEpoch",
    "reason",
    "sessionId",
    "sessionSequence"
  ],
  "title": "ControllerAuthorizationChangedNotification",
  "type": "object"
}